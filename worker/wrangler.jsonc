{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sssmantrajapam-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`, see README):
  // SUPABASE_URL, SUPABASE_KEY, BREVO_API_KEY, BREVO_SENDER_EMAIL, BREVO_SENDER_NAME,
  // SESSION_SECRET, REVIEW_LOGIN_EMAIL, REVIEW_LOGIN_PASSWORD, ALLOWED_ORIGINS
}
